{
  "name": "sprout-expedition-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-mobile.mjs",
    "sync:android": "npm run build:web && npx cap sync android",
    "sync:android:test-ads": "SPROUT_TEST_ADS=1 npm run build:web && npx cap sync android",
    "check:mobile": "node scripts/mobile-smoke.mjs && node scripts/static-check.mjs",
    "check:release-art": "node scripts/check-release-assets.mjs",
    "check:packaged-art": "node scripts/check-packaged-art.mjs",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0"
  }
}
